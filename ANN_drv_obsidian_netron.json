{ "id": "obsidian-netron", "name": "Obsidian NETRON", "version": 1, "verified": true,
  "match": { "esta": [8870], "oem": [10785] },
  "probe": { "contains": "ptFramerate" },
  "read":  { "path": "/DMXPorts.json", "format": "flatArray" },
  "write": { "method": "POST", "path": "/save_dmx_port", "index": "idx", "indexBase": 1,
             "send": ["ptLabel", "ptMode", "ptUniverse", "ptSendValue", "ptProtocol", "ptFramerate", "ptRDM",
                      "ptMergeMode", "ptMergeUniverse", "ptResendUniverse", "ptResendProtocol", "ptClonePort",
                      "ptRangeFrom", "ptRangeTo", "ptOffsetAddr", "ptPriority", "ptSignallossAct",
                      "ptEmergencyMode", "ptEmergencyLevel"],
             "extra": [["EndFlag", "1"]] },
  "fields": { "hz": { "key": "ptFramerate",
                      "options": [[0, "10 Hz"], [1, "15 Hz"], [2, "20 Hz"], [3, "25 Hz"], [4, "30 Hz"],
                                  [5, "35 Hz"], [6, "40 Hz"]] },
              "range": { "from": "ptRangeFrom", "to": "ptRangeTo", "min": 1, "max": 512 } } }
